[Unit]
Description=iSee Ticks website and public demo proxy
Documentation=file:///opt/stock-observability/README
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=stock_website
WorkingDirectory=/var/lib/stock_website
EnvironmentFile=/etc/stock-observability/stock-website.env
ExecStart=/opt/stock-observability/bin/stock_website $STOCK_WEBSITE_ARGS
Restart=on-failure
RestartSec=5s

# Bind :80/:443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
MemoryMax=256M

[Install]
WantedBy=multi-user.target
