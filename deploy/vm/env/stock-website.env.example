# /etc/stock-observability/stock-website.env
# IP-only mode (no domain yet): site on :80, read-only demo on :8080.
STOCK_WEBSITE_ARGS="--web.listen-address=:80 --demo.listen-address=:8080 --demo.home-url=http://127.0.0.1:8081 --demo.grafana-url=http://127.0.0.1:3000 --db.path=/var/lib/stock_website/site.db"

# Domain mode: point A records of both names at the VM, open 443, then use:
# STOCK_WEBSITE_ARGS="--web.listen-address=:80 --web.tls-listen-address=:443 --site.domain=iseeticks.com --demo.domain=demo.iseeticks.com --tls.cache-dir=/var/lib/stock_website/autocert --tls.email=you@example.com --demo.home-url=http://127.0.0.1:8081 --demo.grafana-url=http://127.0.0.1:3000 --db.path=/var/lib/stock_website/site.db"
