# Local defaults avoid binding privileged/common ports. Public hosting uses 80/443.
HTTP_PORT=8080
HTTPS_PORT=8443
HTTPS_REDIRECT_PORT=:8443
ADMIN_HTTP_PORT=8081
ADMIN_HTTPS_PORT=8444
ADMIN_HTTPS_REDIRECT_PORT=:8444
NGINX_BASE_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine-slim

# Set the Kite API key here or in the process environment. Keep its secret in secrets/kite_api_secret.
KITE_API_KEY=

# Admin deployment values. The demo hostname must start with "demo." for Nginx routing.
SITE_URL=https://www.localhost:8444
DEMO_PUBLIC_URL=https://demo.localhost:8443
GRAFANA_INTERNAL_URL=
OPENBB_INTERNAL_URL=
PORTAL_USERNAME=admin

# One name for users, or both site and demo names for the admin deployment.
CERT_DOMAINS=
TLS_EMAIL=